+{% extends "base.html" %}
+
+{% block title %}Buy Stock | Athena Trading{% endblock %}
+
+{% block content %}
+
+<section class="page-heading">
+    <h2>Trade</h2>
+    <p>Add something new to your portfolio. ✦</p>
+</section>
+
+<div class="trade-toolbar">
+    <div class="trade-tabs" role="tablist">
+        <a class="trade-tab active buy" href="{{ url_for('buy') }}" role="tab" aria-selected="true">Buy</a>
+        <a class="trade-tab" href="{{ url_for('sell') }}" role="tab" aria-selected="false">Sell</a>
+    </div>
+
+    <div class="market-status {{ '' if market_open else 'closed' }}">
+        <span class="market-dot"></span>
+        {{ market_message }}
+    </div>
+</div>
+
+<form class="trade-layout" method="post" action="{{ url_for('buy') }}"
+      data-trade-form data-side="buy" data-cash="{{ cash }}">
+
+    <section class="card trade-card">
+        <h3>Buy Stock</h3>
+
+        <div class="form-group">
+            <label for="stock_id">Stock</label>
+            <select id="stock_id" name="stock_id" required>
+                <option value="" disabled {{ 'selected' if not selected_id }}>Choose a stock</option>
+                {% for stock in stocks %}
+                <option value="{{ stock.stock_id }}"
+                        data-price="{{ stock.current_price }}"
+                        data-volume="{{ stock.volume_available }}"
+                        {{ 'selected' if stock.stock_id == selected_id }}>
+                    {{ stock.ticker_symbol }} · {{ stock.company_name }}
+                </option>
+                {% endfor %}
+            </select>
+        </div>
+
+        <div class="form-group">
+            <span class="label">Order type</span>
+            <div class="segmented">
+                <label>
+                    <input type="radio" name="order_kind" value="market" checked>
+                    <span>Market</span>
+                </label>
+                <label>
+                    <input type="radio" name="order_kind" value="limit">
+                    <span>Limit</span>
+                </label>
+            </div>
+            <p class="hint" data-kind-hint="market">Buys right away at the current price.</p>
+            <p class="hint" data-kind-hint="limit" hidden>Buys automatically once the price drops to your limit or lower.</p>
+        </div>
+
+        <div class="form-row">
+            <div class="form-group">
+                <label for="quantity">Quantity (shares)</label>
+                <input type="number" id="quantity" name="quantity" min="1" step="1"
+                       inputmode="numeric" placeholder="0" required>
+            </div>
+
+            <div class="form-group" data-limit-field hidden>
+                <label for="limit_price">Limit price</label>
+                <input type="number" id="limit_price" name="limit_price" min="0.01" step="0.01"
+                       inputmode="decimal" placeholder="0.00">
+            </div>
+        </div>
+
+        <p class="form-error" data-form-error hidden></p>
+
+        <button type="submit" class="primary-button buy-button" {{ 'disabled' if not market_open }}>
+            {{ 'Place Buy Order' if market_open else 'Market Closed' }}
