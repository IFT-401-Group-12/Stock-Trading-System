+    <a href="{{ url_for('buy') }}">Buy a stock</a>
+</section>
+
+{% endif %}
+
+{% endblock %}
+
+{% block scripts %}
+<script src="{{ url_for('static', filename='js/live_prices.js') }}"></script>
+<script src="{{ url_for('static', filename='js/trade_form.js') }}"></script>
+{% endblock %}
